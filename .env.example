# Configure hosted secrets with the Sites environment settings; never put keys in client code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
RESEND_API_KEY=
EMAIL_FROM=
# Restrict real demo delivery to recipients you have verified and authorised, comma-separated.
EMAIL_ALLOWED_RECIPIENTS=
# Optional external scheduler calls POST /api/maintenance with x-scheduler-secret.
SCHEDULER_SECRET=
